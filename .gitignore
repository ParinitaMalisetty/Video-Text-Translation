# =========================
# Environment & Secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Python Virtual Environment
# =========================
venv/
.venv/
env/

# =========================
# Python Cache
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Testing / Coverage
# =========================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# =========================
# Generated Media
# =========================
storage/uploads/*
storage/outputs/*

# Keep the folders in Git
!storage/uploads/.gitkeep
!storage/outputs/.gitkeep

# =========================
# Logs
# =========================
*.log

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# Temporary Files
# =========================
*.tmp
*.temp
*.bak