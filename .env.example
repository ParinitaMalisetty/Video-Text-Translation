# Application Settings
APP_NAME="FastAPI Video Audio Translation Service"
DEBUG=True

# Google Gemini API Key for accurate Indic speech-to-text and translation
# Leave blank or omit to run in fallback / demo mode
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Edge-TTS Neural Voices
TELUGU_VOICE="te-IN-MohanNeural"   # Options: te-IN-MohanNeural (Male), te-IN-ShrutiNeural (Female)
HINDI_VOICE="hi-IN-MadhurNeural"    # Options: hi-IN-MadhurNeural (Male), hi-IN-SwaraNeural (Female)

MAX_UPLOAD_SIZE_MB=150
OUTPUT_DIR=storage/outputs
UPLOAD_DIR=storage/uploads